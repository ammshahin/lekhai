{
  "name": "voice-app",
  "private": true,
  "description": "Voice dictation + meeting/lecture transcriber (working name)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @voice-app/desktop tauri dev",
    "build:desktop": "pnpm --filter @voice-app/desktop tauri build",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @voice-app/eval run eval"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "~5.9.3"
  }
}
